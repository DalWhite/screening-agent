# --- LLM provider (local OpenAI-compatible server: llama.cpp / LM Studio / Strata) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=qwen3.8-flash-next-iq3_xxs
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700
# Qwen3 hybrid thinking: false = low latency, true = deeper reasoning
LLM_THINKING=false
# "auto" falls back to the deterministic MockLLM if the server is unreachable (demo safety net)
LLM_FALLBACK=auto

# --- Storage ---
DB_PATH=data/sazon.db

# --- Re-engagement (demo-friendly values; production values in docs/deployment_design.md) ---
REENGAGE_FIRST_DELAY_SECONDS=45
REENGAGE_SECOND_DELAY_SECONDS=120
REENGAGE_MAX_ATTEMPTS=2
SESSION_IDLE_SECONDS=300
# Ventana (horas) para retomar una conversación abandonada con su session id
RESUME_WINDOW_HOURS=48

# --- Privacy ---
PII_REDACTION=true
RETENTION_DAYS=90

# --- Channels: Twilio WhatsApp + Voice (leave SID/token empty to disable) ---
TWILIO_ACCOUNT_SID=
# Console > Account Info > Auth Token (32 hex chars). NOT the "Test credentials" token, NOT an API key secret.
TWILIO_AUTH_TOKEN=
# Optional: use an API key (SK...) for REST calls instead of the auth token (webhook signatures still need the token)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# WhatsApp-enabled sender, e.g. whatsapp:+14155238886 (Twilio sandbox)
TWILIO_WHATSAPP_FROM=
# Approved Content Template (HX...) for business-initiated pushes (re-engagement nudges) when WhatsApp
# refuses free-form text: outside the 24h window or template-only senders (error 21654/63016).
# Variables: {{1}} = candidate first name, {{2}} = agent name. Example body:
#   "Hola {{1}}, soy {{2}} de Grupo Sazón. Cuando quieras seguimos con tu solicitud: responde y retomamos donde lo dejamos."
TWILIO_WHATSAPP_CONTENT_SID=
# Reject webhooks whose X-Twilio-Signature does not match (keep true in production)
TWILIO_VALIDATE_SIGNATURES=true
# Public HTTPS origin Twilio calls back to (e.g. https://screening.example.com or an ngrok URL);
# used for signature validation and absolute TwiML action URLs
PUBLIC_BASE_URL=
# Optional Twilio TTS voice for calls (e.g. Polly.Lucia / Polly.Joanna); empty = Twilio default
VOICE_TTS_VOICE=
# In-call silence handling: re-prompts before hanging up and marking the session abandoned
VOICE_MAX_SILENCE_RETRIES=2
# Outbound WhatsApp messages longer than this are split on sentence boundaries
WHATSAPP_CHAR_LIMIT=1500
# Twilio drops webhooks after 15s. If the agent (LLM) takes longer than this, the webhook
# answers immediately and the reply is delivered through the REST API instead (needs TWILIO_WHATSAPP_FROM)
WHATSAPP_SYNC_TIMEOUT_SECONDS=10
